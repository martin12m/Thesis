# LLM backend: llama_cpp (local) or openai_compatible (hosted)
LLM_BACKEND=openai_compatible
LLM_BASE_URL=<your inference provider base url>
LLM_API_KEY=<your api key>
LLM_MODEL=<llm model e.g. qwen/qwen3.6-27b>
LLM_EXTRA_PARAMS={"reasoning_effort": "none"}
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Local model (llama_cpp backend)
MODEL_PATH=<path to a local .gguf model e.g. models/Llama-3.2-3B-Instruct-Q3_K_M.gguf>
LLM_CONTEXT_WINDOW=4096

# Named model profiles, selectable via scripts/run_evaluation.py --model
LLM_PROFILES=<comma-separated profile names e.g. qwen,gptoss20b,localllama>

LLM_PROFILE_QWEN_BACKEND=openai_compatible
LLM_PROFILE_QWEN_MODEL=<llm model e.g. qwen/qwen3.6-27b>
LLM_PROFILE_QWEN_EXTRA_PARAMS={"reasoning_effort": "none"}

LLM_PROFILE_GPTOSS20B_BACKEND=openai_compatible
LLM_PROFILE_GPTOSS20B_MODEL=<llm model e.g. openai/gpt-oss-20b>
LLM_PROFILE_GPTOSS20B_EXTRA_PARAMS={}

LLM_PROFILE_LOCALLLAMA_BACKEND=llama_cpp
LLM_PROFILE_LOCALLLAMA_MODEL_PATH=<path to a local .gguf model>

# Catalog
COMMERCE_PRODUCT_SOURCE=<dummyjson or local>
DUMMYJSON_BASE_URL=https://dummyjson.com
CATALOG_DB_PATH=data/catalog.db

# Optional external product-reviews API
CATALOG_REVIEWS_SOURCE=<local or external>
EXTERNAL_REVIEWS_BASE_URL=<your reviews api base url>
EXTERNAL_REVIEWS_USER=<your reviews api user>
EXTERNAL_REVIEWS_PASSWORD=<your reviews api password>

# Speech
WHISPER_MODEL_SIZE=base
TTS_VOICE=en_US-lessac-medium
TTS_VOICES_DIR=models/piper_voices
